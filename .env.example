DATABASE_URL="postgresql://postgres:postgres@localhost:5432/armenian_anki?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Giphy API key for showing illustrative GIFs on the back of cards
# Sign up at https://developers.giphy.com/ and place your API key here.
# The key is exposed to the client, so use a key with appropriate limits.
NEXT_PUBLIC_GIPHY_API_KEY=""

# Optional: Azure Speech for Armenian pronunciation audio (Play button on cards)
# Create a "Speech service" resource on the Free F0 tier at https://portal.azure.com
# and copy KEY 1 and Location/Region from "Keys and Endpoint". Server-side only.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# hy-AM-AnahitNeural (female, default) or hy-AM-HaykNeural (male)
AZURE_SPEECH_VOICE=""
# Where generated MP3s are cached; mount a volume here to keep them across deploys
TTS_CACHE_DIR=""
